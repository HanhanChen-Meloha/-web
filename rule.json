{
  "rules": {
    // 預設將整個資料庫全部鎖定，禁止任何讀寫
    ".read": false,
    ".write": false,

    "rooms": {
      "$roomId": {
        // 允許讀取房間與玩家狀態（供即時同步對戰與計分）
        ".read": true,

        // 房號必須剛好是 4 位數字 (1000 ~ 9999)
        ".validate": "newData.hasChildren(['host', 'status']) && $roomId.matches(/^[0-9]{4}$/)",

        // 房間基本屬性驗證
        "host": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'finished')"
        },
        "maxPlayers": {
          ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 3"
        },
        "round": {
          ".validate": "newData.isNumber()"
        },

        // 玩家清單節點
        "players": {
          "$playerId": {
            // 允許玩家寫入自己的資料（加入房間、更新出拳、更新分數）
            ".write": "!data.exists() || data.child('id').val() === newData.child('id').val() || newData.parent().parent().child('host').val() === auth.uid",
            
            // 玩家節點必須包含的必要欄位驗證
            ".validate": "newData.hasChildren(['id', 'name', 'choice', 'score'])",

            "id": {
              ".validate": "newData.isString() && newData.val().length > 0"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
            },
            "choice": {
              // 出拳限制只能是：none（未出）, rock（石頭）, paper（布）, scissors（剪刀）
              ".validate": "newData.isString() && (newData.val() === 'none' || newData.val() === 'rock' || newData.val() === 'paper' || newData.val() === 'scissors')"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          }
        }
      }
    }
  }
}